{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Winx-KVM",
  "version": "0.0.1",
  "identifier": "br.com.winxkvm.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "trayIcon": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "label": "main",
        "title": "Winx-KVM",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "createUpdaterArtifacts": false,
    "publisher": "Winx-KVM",
    "copyright": "Copyright © 2026 Winx-KVM contributors",
    "category": "Utility",
    "shortDescription": "Software KVM com áudio compartilhado entre PCs Windows",
    "longDescription": "Winx-KVM compartilha mouse, teclado, clipboard, áudio e arquivos entre PCs Windows na mesma rede local. Conecte-se via QUIC com criptografia end-to-end e pareamento via PIN.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
